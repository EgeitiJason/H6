hostname NW-OOB-DC1-01

no ip domain lookup
banner motd "
=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=
                  M I D D E L F A R T   R A C I N G
=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=
        Authorized use only. Activity is logged and monitored.
        Unauthorized access may result in disciplinary action
                         and/or prosecution.

                  Contact: noc@middelfartracing.dk
=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=o=

"
service password-encryption
username cisco secret cisco

ip default-gateway 10.10.99.1

aaa new-model

radius-server host 10.0.10.16 auth-port 1812 acct-port 1813 key Password1!

aaa group server radius SRV-RADIUS
 server 10.0.10.16 auth-port 1812 acct-port 1813



radius-server vsa send accounting

aaa authorization exec VTY_AUTHOR group SRV-RADIUS local
aaa authentication login VTY_AUTHEN group SRV-RADIUS local

line vty 0 15
 authorization exec VTY_AUTHOR
 login authentication VTY_AUTHEN

int vlan 99
ip address 10.0.99.7 255.255.255.0
exit

ip domain-name mfrace.internal
crypto key generate rsa general-keys modulus 1024
ip ssh version 2

line vty 0 15
password cisco
transport input ssh
exec-timeout 15 0
login local

line console 0
password cisco
exec-timeout 15 0
login local
end

wr



no username cisco secret cisco

username cisco privilege 15 secret cisco

int ran g1/0/1-24
switchport mode access
switchport access vlan 99
no shut

interface port-channel 6
description "NW-DSW-DC1-STACK | Port g1/0/45, g1/0/45"
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99

Interface range g1/0/23-24
channel-protocol lacp
channel-group 6 mode active
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99

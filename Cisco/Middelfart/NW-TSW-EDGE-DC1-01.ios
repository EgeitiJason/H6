hostname NW-TSW-EDGE-DC1-01

no ip domain lookup
banner motd "Unauthorized access is prohibited"
service password-encryption
username cisco secret cisco

int vlan 99
ip address 10.0.99.8 255.255.255.0
exit

ip domain-name mfrace.internal
crypto key generate rsa general-keys modulus 1024
ip ssh version 2

line vty 0 4
password cisco
transport input ssh
exec-timeout 0
login local

line console 0
password cisco
exec-timeout 0
login local
end

wr

no username cisco secret cisco

username cisco privilege 15 secret cisco

default interface g1/0/1
default interface g1/0/2

Interface range g1/0/1-2
switchport mode access
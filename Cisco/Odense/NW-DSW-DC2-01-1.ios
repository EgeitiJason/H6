"
service password-encryption
username cisco secret cisco

int vlan 99
ip address 10.10.99.4 255.255.255.0
exit

ip domain-name mfrace.internal
crypto key generate rsa general-keys modulus 1024
ip ssh version 2

line vty 0 15
password cisco
transport input ssh
exec-timeout 15 0
login local

line console 0
password cisco
exec-timeout 15 0
login local

switch 1 priority 15
end

wr

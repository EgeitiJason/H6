hostname NW-DSW-DC2-01

no username cisco secret cisco
username cisco privilege 15 secret cisco

spanning-tree portfast default
VTP mode server
ip default-gateway 10.10.99.1

aaa new-model

radius server SRV-RADIUS-01
 address ipv4 10.0.10.16 auth-port 1812 acct-port 1813
 key <RADIUS-SECRET>

aaa group server radius SRV-RADIUS
 server name SRV-RADIUS-01

radius-server vsa send accounting

aaa authorization exec VTY_AUTHOR group SRV-RADIUS local
aaa authentication login VTY_AUTHEN group SRV-RADIUS local

line vty 0 15
 exec-timeout 15 0
 authorization exec VTY_AUTHOR
 login authentication VTY_AUTHEN

line console 0
 exec-timeout 15 0

Vlan 10
name Servere

Vlan 20
name Klienter

Vlan 30
name Backup

Vlan 40
name DMZ

Vlan 99
name Management

Vlan 100
name Guest

Vlan 555
name Registraion

Vlan 666
name Jail

Vlan 999
name Blackhole

int vlan 99
ip address 10.10.99.4 255.255.255.0
exit

interface port-channel 44
description "HYP-PVE-BKP-DC2-01 | Bond0"
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 30,99

interface port-channel 45
description "NW-ASW-DC2-01 | Port g1/0/47-48"
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99,100,555,666

interface port-channel 46
description "NW-OOB-DC2-01 | Port g1/0/23-24"
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99

interface port-channel 47
description "NW-FW-EDGE-DC2-02 | Port eth1-2"
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99,100,555,666

interface port-channel 48
description "NW-FW-EDGE-DC2-01 | Port eth1-2"
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99,100,555,666

Interface range g1/0/44, g2/0/44
channel-protocol lacp
channel-group 44 mode active
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 30,99

Interface range g1/0/45, g2/0/45
channel-protocol lacp
channel-group 45 mode active
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99,100,555,666

Interface range g1/0/46, g2/0/46
channel-protocol lacp
channel-group 46 mode active
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99

Interface range g1/0/47, g2/0/47
channel-protocol lacp
channel-group 47 mode active
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99,100,555,666

Interface range g1/0/48, g2/0/48
channel-protocol lacp
channel-group 48 mode active
switchport mode trunk
switchport trunk encapsulation dot1q
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99,100,555,666

Interface range g1/0/1-8
switchport mode access
switchport access vlan 99

auto lo
iface lo inet loopback

# Physical interfaces
iface nic0 inet manual
iface nic1 inet manual
iface nic3 inet manual
iface nic4 inet manual
iface nic5 inet manual
iface nic7 inet manual

# ============================================
# bond0: VMs + Management + Migration (LACP)
# ============================================
auto bond0
iface bond0 inet manual
    bond-slaves nic0 nic4
    bond-miimon 100
    bond-mode 802.3ad
    bond-xmit-hash-policy layer2+3
    bond-lacp-rate slow

# vmbr0: VLAN-aware bridge, no IP of its own.
# VMs get assigned to VLAN 10 or 20 via their NIC config.
auto vmbr0
iface vmbr0 inet manual
    bridge-ports bond0
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 2-4094

# Management (VLAN 99) — holds the default gateway
auto vmbr0.99
iface vmbr0.99 inet static
    address 10.0.99.14/24
    gateway 10.0.99.1

# ============================================
# bond1: Ceph (LACP, jumbo frames)
# ============================================
auto bond1
iface bond1 inet static
    address 172.16.0.12/24
    bond-slaves nic1 nic5
    bond-miimon 100
    bond-mode 802.3ad
    bond-xmit-hash-policy layer3+4
    bond-lacp-rate slow
    mtu 9000

# ============================================
# Corosync ring 0 (nic2, stack member 1)
# ============================================
auto nic2
iface nic2 inet static
    address 172.16.1.12/24
    mtu 1500

# ============================================
# Corosync ring 1 (nic6, stack member 2)
# ============================================
auto nic6
iface nic6 inet static
    address 172.16.2.12/24
    mtu 1500
